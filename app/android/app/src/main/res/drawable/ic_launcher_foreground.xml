<?xml version="1.0" encoding="utf-8"?>
<!-- 108dp adaptive-icon layer; the glyph stays inside the central 72dp that is always visible.
     Same geometry as app/tool/icon.svg and app/tool/make_icons.dart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- ring, open at the top right -->
    <path
        android:pathData="M73.81,51.22A20,20 0 1,1 60.18,34.98"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- check mark leaving through the gap -->
    <path
        android:pathData="M44,56L52,64L73,39"
        android:strokeColor="#FFC94A"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
