          {
            "pattern": "^$|^[A-Za-z0-9_.@!#%^*+=-]{8,64}$",
            "message": "8-64 位，只能用字母、数字和 _ . @ ! # % ^ * + = -"
          }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_bind",
        "label": "监听地址",
        "initValue": "0.0.0.0",
